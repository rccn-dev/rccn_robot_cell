<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="rccn_kuka_robot_cell_ros2_control" params="name initial_positions_file robot_ip robot_port use_mock">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
      <xacro:if value="${use_mock}">
        <hardware>
          <!-- Default: mock system for simulation -->
          <plugin>mock_components/GenericSystem</plugin>
        </hardware>
      </xacro:if>
      <xacro:unless value="${use_mock}">
        <hardware>
          <!-- Real hardware: east_on_rail only -->
          <plugin>kuka_hw_axis/KukaHardwareInterface</plugin>
          <param name="robot_ip">${robot_ip}</param>
          <param name="robot_port">${robot_port}</param>
        </hardware>
      </xacro:unless>
            <joint name="east_joint_e1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['east_joint_e1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="east_joint_a1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['east_joint_a1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="east_joint_a2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['east_joint_a2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="east_joint_a3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['east_joint_a3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="east_joint_a4">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['east_joint_a4']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="east_joint_a5">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['east_joint_a5']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="east_joint_a6">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['east_joint_a6']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <xacro:if value="${use_mock}">
            <joint name="west_joint_a1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['west_joint_a1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="west_joint_a2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['west_joint_a2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="west_joint_a3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['west_joint_a3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="west_joint_a4">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['west_joint_a4']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="west_joint_a5">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['west_joint_a5']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="west_joint_a6">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['west_joint_a6']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="west_joint_e1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['west_joint_e1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            </xacro:if>

        </ros2_control>
    </xacro:macro>
</robot>
